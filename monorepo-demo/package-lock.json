{
  "name": "monorepo-demo",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "monorepo-demo",
      "version": "1.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "name": "@monorepo/api",
      "version": "1.0.0",
      "dependencies": {
        "@monorepo/utils": "*"
      }
    },
    "apps/web": {
      "name": "@monorepo/web",
      "version": "1.0.0",
      "dependencies": {
        "@monorepo/utils": "*"
      }
    },
    "node_modules/@monorepo/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@monorepo/utils": {
      "resolved": "packages/utils",
      "link": true
    },
    "node_modules/@monorepo/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/utils": {
      "name": "@monorepo/utils",
      "version": "1.0.0",
      "license": "MIT"
    }
  }
}
